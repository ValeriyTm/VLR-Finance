# Database URLs
DATABASE_URL_AUTH=postgresql://postgres:postgres@localhost:5432/auth
DATABASE_URL_PORTFOLIO=postgresql://postgres:postgres@localhost:5432/portfolio
DATABASE_URL_AI=postgresql://postgres:postgres@localhost:5432/ai
CLICKHOUSE_URL=http://localhost:8123
REDIS_URL=redis://localhost:6379

# Message Brokers
KAFKA_BROKERS=kafka:9092
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# Storage
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_USE_SSL=false

# Observability
PROMETHEUS_ENDPOINT=http://localhost:9090
TEMPO_ENDPOINT=http://localhost:4318
LOKI_ENDPOINT=http://localhost:3100

# Application
NODE_ENV=development
PORT=3000

# Auth Service
JWT_ACCESS_SECRET=your-super-secret-access-key-change-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002

# Ingestor Service
KAFKA_BROKERS=kafka:9092
MOCK_STRATEGY=true
SYMBOLS=btcusdt,ethusdt
MOCK_INTERVAL=1000
BINANCE_WS_URL=wss://stream.binance.com:9443/ws
MAX_RECONNECT_ATTEMPTS=10
RECONNECT_INTERVAL=5000
